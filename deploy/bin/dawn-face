#!/usr/bin/env bash
# Dawn kiosk: cage (Wayland) + Chromium fullscreen on the face URL. Runs as user dawn on tty1.
set -u
URL="${DAWN_FACE_URL:-http://127.0.0.1:8080/face}"
MODEL="$(tr -d '\0' </proc/device-tree/model 2>/dev/null || true)"
BROWSER="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$BROWSER" ] || { echo "no chromium found"; sleep 10; exit 1; }

# wait for core (the face reconnects on its own afterwards)
for _ in $(seq 1 60); do curl -sf "${URL%/face}/api/health" >/dev/null 2>&1 && break; sleep 1; done

FLAGS=(
  --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble
  --ozone-platform=wayland --enable-features=UseOzonePlatform,OverlayScrollbar --touch-events=enabled
  --disable-pinch --overscroll-history-navigation=0 --autoplay-policy=no-user-gesture-required
  --check-for-update-interval=31536000 --disable-component-update --disable-background-networking
  --disk-cache-dir=/tmp/dawn-face-cache --disk-cache-size=16000000 --password-store=basic
  --disable-features=TranslateUI,Translate --hide-scrollbars --force-dark-mode
)
case "$MODEL" in
  *"Zero 2"*|*"Pi 3"*) FLAGS+=(--disable-gpu-compositing --disable-smooth-scrolling --renderer-process-limit=1 --js-flags=--max-old-space-size=96);;
esac
export WLR_LIBINPUT_NO_DEVICES=1   # HDMI panels without touch must still start
export XDG_SESSION_TYPE=wayland
rm -rf /tmp/dawn-face-cache
exec cage -d -s -- "$BROWSER" "${FLAGS[@]}" "$URL"
