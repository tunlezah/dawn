# Dawn gpsd defaults (/etc/default/gpsd)
# u-blox 7 USB GPS (VK-172 / VK-162) enumerates as a CDC ACM device; the udev
# rule in deploy/udev also creates /dev/gps0 so the path is stable.
START_DAEMON="true"
USBAUTO="true"
DEVICES="/dev/gps0"
# -n: poll the receiver even with no client connected so chrony always has data
GPSD_OPTIONS="-n"
