[Unit]
Description=Dawn DAB+ time to chrony SHM 2
After=dawn-dab.service chrony.service
Wants=chrony.service
# never give up restarting (systemd's default stops after 5 starts in 10 s); dawn-core restarts it as well when
# it stops writing its status file
StartLimitIntervalSec=0

[Service]
# READY=1 after its first pass, WATCHDOG=1 on every pass (its FIC read times out after 10 s, so a pass is short):
# a dawn-timed hung on a socket is restarted by systemd itself, not only by dawn-core's supervisor
Type=notify
NotifyAccess=main
WatchdogSec=60
User=dawn
Group=dawn
ExecStart=@DAWN_DIR@/.venv/bin/dawn-timed --welle-url http://127.0.0.1:8000 --shm-unit 2 --status-file /run/dawn-timed/status.json
# status.json: what the daemon sees, read by dawn-core for Diagnostics -> Time
RuntimeDirectory=dawn-timed
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=dawn-timed

[Install]
WantedBy=multi-user.target
