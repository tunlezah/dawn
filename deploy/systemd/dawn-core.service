[Unit]
Description=Dawn core (state, alarms, audio arbiter, API)
Documentation=https://github.com/tunlezah/dawn
After=network.target chrony.service bluetooth.service user@@UID@.service
Wants=user@@UID@.service
# never give up restarting: the alarms live here (systemd's default stops after 5 starts in 10 s)
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=dawn
Group=dawn
SupplementaryGroups=audio video render input gpio i2c dialout plugdev bluetooth netdev
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DAWN_CONFIG=/etc/dawn/config.yaml
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@DAWN_DIR@
ExecStart=@DAWN_DIR@/.venv/bin/dawn-core
Restart=always
RestartSec=2
WatchdogSec=60
TimeoutStartSec=90
# dawn-core stops its services within 35 s (ServiceRegistry.stop_all); the default 90 s held a restart for longer
TimeoutStopSec=45
# the alarms live here: the kernel's OOM killer takes almost anything else first (Chromium, welle-cli)
OOMScoreAdjust=-800
# no core dumps onto the SD card
LimitCORE=0
RuntimeDirectory=dawn
RuntimeDirectoryMode=0755
# kept until reboot (systemd deletes it whenever the service stops by default): a ring stopped while the
# database could not be written leaves a marker here, so the restart does not bring it back
RuntimeDirectoryPreserve=yes
StateDirectory=dawn
# modest hardening (GPIO/I2C/audio need device access, so no PrivateDevices)
NoNewPrivileges=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
