<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Dawn control UI advertised on the LAN as http://<hostname>.local/ -->
<service-group>
  <name replace-wildcards="yes">Dawn on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>8080</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
